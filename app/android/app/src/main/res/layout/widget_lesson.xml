<?xml version="1.0" encoding="utf-8"?>
<!-- «Пара», 2×2: сверху «через 12 мин» (или «идёт» зелёным), крупно кабинет
     (или «23’» до конца), ниже предмет. Тексты здесь — пример для списка
     виджетов, настоящие ставит widget/Widgets.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/w_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="через 12 мин"
        android:textColor="@color/w_accent"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_big"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="38sp"
        android:autoSizeMinTextSize="16sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:gravity="center_vertical|start"
        android:maxLines="1"
        android:text="А-17"
        android:textColor="@color/w_text"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Анализ данных"
        android:textColor="@color/w_muted"
        android:textSize="13sp" />
</LinearLayout>
