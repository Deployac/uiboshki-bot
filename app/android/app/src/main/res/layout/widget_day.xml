<?xml version="1.0" encoding="utf-8"?>
<!-- «Весь день», 4×4: «ЧТ, 8 ОКТ · 5 ПАР», строки пар (widget_day_row,
     добавляет widget/Widgets.kt), внизу горящий срок красным. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/w_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:letterSpacing="0.06"
        android:maxLines="1"
        android:text="КАПИБАРА"
        android:textColor="@color/w_muted"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/w_text"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- строки пар; не влезли — обрезаются снизу, срок остаётся виден -->
    <LinearLayout
        android:id="@+id/w_rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/w_deadline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/w_danger"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
